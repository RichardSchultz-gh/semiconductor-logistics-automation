@startuml Frau_Holle_Container_C4

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container diagram for Frau Holle System

Person(worker, "Fabrikarbeiter", "Ein Benutzer, der in der Halbleiterfabrik arbeitet und die Fertigungsprozesse überwacht.")
Person(manager, "Abteilungsleiter", "Verantwortlich für die Überwachung der Produktionsabläufe.")

Boundary(frauHolleBoundary, "Frau Holle ") {

Container(frauHolleApp, "Frau Holle Anwendung", "Webanwendung", "Ermöglicht Benutzern die Überwachung und Verwaltung der Fertigungsprozesse.")
Container(db, "Datenbank", "Datenbank-Management-System", "Speichert Nutzerdaten und -parameter.")
Container(api, "API", "RESTful API", "Stellt eine Schnittstelle für den Datenzugriff und Managementfunktionen bereit.")

Rel(worker, frauHolleApp, "Benutzt")
Rel(manager, frauHolleApp, "Benutzt und überwacht")
Rel(frauHolleApp, api, "nutzt")


}

System_Ext(manufacturing, "Fertigung", "Hier finden die Fertigungsprozesse statt und werden aufgezeichnet")


Rel(api, manufacturing, "holt Produktionsdaten")
Rel(api, db, "holt Nutzerdaten")
@enduml
